<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header row 1: Title + Add button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="AKUN TERSIMPAN"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="36dp"
                android:layout_height="3dp"
                android:background="@color/primary"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAccount"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ TAMBAH"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="HAPUS SEMUA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/error"
            app:backgroundTint="@color/surface"
            app:strokeColor="@color/error"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <!-- Header row 2: Refresh All -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshAll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="↻  REFRESH SEMUA COOKIE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F0F0F0"
            app:backgroundTint="@color/surface2"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada akun tersimpan.\nGrab atau tap + untuk tambah manual."
        android:textColor="@color/on_surface_dim"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginTop="80dp"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
